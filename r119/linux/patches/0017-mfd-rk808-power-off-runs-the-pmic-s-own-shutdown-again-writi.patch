@@ -1262,7 +1252,7 @@ static void rk808_syscore_shutdown(void)
 			continue;
 		}
 
-		if (entry->rk808->shutdown) {
+		if (!entry->rk808->shutdown) {
 			pr_warn("RK808: No shutdown function for PMIC variant 0x%lx\n",
 				entry->rk808->variant);
 			continue;
