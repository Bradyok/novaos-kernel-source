		panel-exit-sequence = [
			05 32 01 28
			05 64 01 10
		];

		display-timings {
			native-mode = <&dsi_timing0>;

			dsi_timing0: timing0 {
				clock-frequency = <68000000>;
				hactive = <1024>;
				vactive = <600>;
				hfront-porch = <20>;
				hback-porch = <20>;
				hsync-len = <20>;
				vfront-porch = <30>;
				vback-porch = <10>;
				vsync-len = <4>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

&pwm0 {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vdpu {
	status = "okay";
};

&vpu_mmu {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&vdec_mmu {
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&rga {
	status = "okay";
};

&vpu {
	status = "disabled";
};

&vdec {
	status = "disabled";
};

/* The touch controller, I2C2 at 0x38: interrupt GPIO4_A6, reset GPIO4_A7. */
&i2c2 {
	clock-frequency = <100000>;
	i2c-scl-rising-time-ns = <160>;
	i2c-scl-falling-time-ns = <30>;
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft5422";
		reg = <0x38>;
		interrupt-parent = <&gpio4>;
		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio4 7 GPIO_ACTIVE_LOW>;
		vcc-supply = <&vcc3v0_tp>;
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <600>;
	};
};

&i2c1 {
	clock-frequency = <100000>;
	i2c-scl-rising-time-ns = <500>;
	i2c-scl-falling-time-ns = <200>;
	status = "okay";

	adc@37 {
		compatible = "ti,adc128d818";
		reg = <0x37>;
		status = "disabled";
	};
};

&i2c4 {
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <160>;
	i2c-scl-falling-time-ns = <30>;
	status = "okay";

	temperature-sensor@1d {
		compatible = "ti,tmp421";
		reg = <0x1d>;
		status = "disabled";
	};

	temperature-sensor@1f {
		compatible = "ti,tmp421";
		reg = <0x1f>;
		status = "disabled";
	};

	temperature-sensor@2a {
		compatible = "ti,tmp421";
		reg = <0x2a>;
		status = "disabled";
	};

	temperature-sensor@4c {
		compatible = "ti,tmp421";
		reg = <0x4c>;
		status = "disabled";
	};

	temperature-sensor@4f {
		compatible = "ti,tmp421";
		reg = <0x4f>;
		status = "disabled";
	};
};

&spi1 {
	status = "okay";

	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
};

&spi2 {
	status = "disabled";

	spidev@0 {
		compatible = "rockchip,spidev";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
};

&cluster0_opp {
	rockchip,bin-scaling-sel = <0 30  1 34  2 46>;
	rockchip,bin-voltage-sel = <2 20>;
	opp-408000000 { opp-microvolt-L20 = <875000 875000 1250000>; };
	opp-600000000 { opp-microvolt-L20 = <875000 875000 1250000>; };
	opp-816000000 { opp-microvolt-L20 = <900000 900000 1250000>; };
	opp-1008000000 { opp-microvolt-L20 = <975000 975000 1250000>; };
	opp-1416000000 { opp-microvolt-L2 = <1075000 1075000 1250000>; };
};

&cluster1_opp {
	rockchip,bin-scaling-sel = <0 8  1 17  2 30>;
	rockchip,bin-voltage-sel = <2 20>;
	rockchip,pvtm-voltage-sel = <
		0       149000  0
		149001  155000  1
		155001  160000  2
		160001  999999  3
	>;
	opp-408000000 { opp-microvolt-L20 = <875000 875000 1250000>; };
	opp-600000000 { opp-microvolt-L20 = <875000 875000 1250000>; };
	opp-816000000 { opp-microvolt-L20 = <875000 875000 1250000>; };
	opp-1008000000 { opp-microvolt-L20 = <925000 925000 1250000>; };
	opp-1200000000 { opp-microvolt-L20 = <1000000 1000000 1250000>; };
	opp-1416000000 { opp-microvolt-L20 = <1075000 1075000 1250000>; };
	opp-1512000000 {
		opp-hz = /bits/ 64 <1512000000>;
		opp-microvolt = <1100000 1100000 1250000>;
		opp-microvolt-L0 = <1100000 1100000 1250000>;
		opp-microvolt-L1 = <1075000 1075000 1250000>;
		opp-microvolt-L2 = <1050000 1050000 1250000>;
		opp-microvolt-L3 = <1025000 1025000 1250000>;
		opp-microvolt-L4 = <1025000 1025000 1250000>;
		opp-microvolt-L20 = <1150000 1150000 1250000>;
		clock-latency-ns = <40000>;
	};
};

&gpu_opp_table {
	rockchip,bin-voltage-sel = <2 20>;
	opp-200000000 { opp-microvolt-L20 = <875000 875000 1150000>; };
	opp-300000000 { opp-microvolt-L20 = <875000 875000 1150000>; };
	opp-400000000 { opp-microvolt-L20 = <875000 875000 1150000>; };
	opp-600000000 { opp-microvolt-L20 = <975000 975000 1150000>; };
};

/delete-node/ &ramoops;
/delete-node/ &ramoops_mem;

&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <1>;
	rockchip,hw-tshut-temp = <120000>;
	status = "okay";
};

/*
 * The pin controller's own default state: PCIe PERST# (GPIO2_C2) an input with no pull until the PCIe
 * host takes it, and the front ends' SPI bus pins (GPIO2_B1-B4, SPI2's pins: &spi2 stays disabled) as
 * GPIO with pull-ups, MISO idling high.
 */
&pinctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_perst_float &afe_spi_pins>;

	pcie {
		pcie_perst_float: pcie-perst-float {
			rockchip,pins = <2 18 0 &pcfg_pull_none>;
		};
	};

	afe-spi {
		afe_spi_pins: afe-spi-pins {
			rockchip,pins = <2 9 0 &pcfg_pull_up>,
					<2 10 0 &pcfg_pull_up>,
					<2 11 0 &pcfg_pull_up>,
					<2 12 0 &pcfg_pull_up>;
		};
	};

	pmic {
		pmic_int_l: pmic-int-l {
			rockchip,pins = <1 21 0 &pcfg_pull_up>;
		};

		vsel1_gpio: vsel1-gpio {
			rockchip,pins = <1 23 0 &pcfg_pull_down>;
		};

		vsel2_gpio: vsel2-gpio {
			rockchip,pins = <1 14 0 &pcfg_pull_down>;
		};
	};
};

/*
 * The board's analog front ends, generator, sample-clock PLL and straps are plain GPIO lines with no
 * kernel driver: userspace drives them through the GPIO character device, by these line names.
 *   hd_code0..3        the board straps (inputs)
 *   afg_in1..5         the generator's control lines; FG_M2C_GPIO its supply (&spdif stays off)
 *   afe1..4            the front ends' DAC gear lines
 *   spi_afe_*          the front ends' SPI bus (four chip selects, active low)
 *   spi_sclk/sdio/le   the LMX2582 PLL's 3-wire bus, write only, latch active high (&pwm3 stays off)
 *   LA_PROBE_DETECT    the logic-analyser probe detect (input)
 * gpio N is bank N / 32, pin N % 32.
 */
&gpio0 {
	gpio-line-names =
		/* A0-A7 */ "", "", "spi_sdio", "spi_sclk", "hd_code0", "power", "spi_le", "",
		/* B0-B7 */ "hd_code1", "", "", "hd_code2", "hd_code3", "", "", "",
		/* C0-C7 */ "", "", "", "", "", "", "", "",
		/* D0-D7 */ "", "", "", "", "", "", "", "";
};

&gpio1 {
	gpio-line-names =
		/* A0-A7 */ "", "", "", "", "", "", "", "",
		/* B0-B7 */ "", "", "", "", "", "", "vsel", "",
		/* C0-C7 */ "", "", "enable", "", "reset", "", "", "vsel",
		/* D0-D7 */ "", "", "", "", "", "", "", "";

	/*
	 * The SYR827 (vdd_cpu_b) and SYR828 (vdd_gpu) VSEL pins, driven low from GPIO probe: VSEL low
	 * selects the VSEL0 register, the one the fan53555 driver programs with
	 * fcs,suspend-voltage-selector = <1>. The driver does not drive the pins itself.
	 */
	vsel1-hog {
		gpio-hog;
		gpios = <23 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "vsel";
	};

	vsel2-hog {
		gpio-hog;
		gpios = <14 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "vsel";
	};
};

&gpio2 {
	gpio-line-names =
		/* A0-A7 */ "", "", "spi_afe_cs_1", "", "spi_afe_cs_3", "spi_afe_cs_2", "", "",
		/* B0-B7 */ "", "spi_afe_miso", "spi_afe_mosi", "spi_afe_sclk", "spi_afe_cs_0", "", "", "",
		/* C0-C7 */ "", "", "ep", "", "", "", "", "",
		/* D0-D7 */ "", "", "", "", "", "", "", "";
};

&gpio3 {
	gpio-line-names =
		/* A0-A7 */ "", "", "", "", "", "", "", "",
		/* B0-B7 */ "", "", "", "", "", "", "", "mdio-reset",
		/* C0-C7 */ "", "", "", "", "", "", "", "",
		/* D0-D7 */ "LA_PROBE_DETECT", "", "afg_in1", "afg_in2", "afg_in3", "afg_in4", "afg_in5", "";
};

&gpio4 {
	gpio-line-names =
		/* A0-A7 */ "", "", "", "PWM_GPIO", "", "fan_power", "fts_irq_gpio", "fts_reset_gpio",
		/* B0-B7 */ "", "", "", "", "", "", "", "",
		/* C0-C7 */ "", "", "", "", "", "FG_M2C_GPIO", "", "",
		/* D0-D7 */ "", "afe1", "afe2", "", "", "afe3", "afe4", "";

	/* The cooling fan on from GPIO probe. */
	fan-power-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "fan_power";
	};
};
