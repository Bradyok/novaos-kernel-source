From: Brady <brady@aioscilloscope.com>
Subject: video: rockchip: mpp: absent optional NIU resets are not errors
Copyright (C) 2026 Olympian LED, Inc.

The Rockchip MPP video decoders asked for NIU resets that the device trees
do not name and logged their absence as errors, although the reset helpers
skip a missing control. Log these at debug level.

---
diff --git a/drivers/video/rockchip/mpp/mpp_common.c b/drivers/video/rockchip/mpp/mpp_common.c
--- a/drivers/video/rockchip/mpp/mpp_common.c
+++ b/drivers/video/rockchip/mpp/mpp_common.c
@@ -662,7 +662,8 @@ mpp_reset_control_get(struct mpp_dev *mpp, enum MPP_RESET_TYPE type, const char
 	index = of_property_match_string(mpp->dev->of_node,
 					 "reset-names", shared_name);
 	if (index < 0) {
-		dev_err(mpp->dev, "%s is not found!\n", shared_name);
+		/* Absent: each caller reports a reset it cannot do without. */
+		dev_dbg(mpp->dev, "%s is not found!\n", shared_name);
 		return NULL;
 	}
 
diff --git a/drivers/video/rockchip/mpp/mpp_rkvdec.c b/drivers/video/rockchip/mpp/mpp_rkvdec.c
--- a/drivers/video/rockchip/mpp/mpp_rkvdec.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvdec.c
@@ -1158,12 +1158,17 @@ static int rkvdec_init(struct mpp_dev *mpp)
 	dec->rst_h = mpp_reset_control_get(mpp, RST_TYPE_H, "video_h");
 	if (!dec->rst_h)
 		mpp_err("No hclk reset resource define\n");
+	/*
+	 * The NIU resets are optional: a decoder node that names none (the RK356x rkvdec,
+	 * whose reset-names are video_a/h, cabac, core and hevc_cabac) is reset without
+	 * them, as mpp_safe_reset()/mpp_safe_unreset() skip a NULL control.
+	 */
 	dec->rst_niu_a = mpp_reset_control_get(mpp, RST_TYPE_NIU_A, "niu_a");
 	if (!dec->rst_niu_a)
-		mpp_err("No niu aclk reset resource define\n");
+		dev_dbg(mpp->dev, "No niu aclk reset resource define\n");
 	dec->rst_niu_h = mpp_reset_control_get(mpp, RST_TYPE_NIU_H, "niu_h");
 	if (!dec->rst_niu_h)
-		mpp_err("No niu hclk reset resource define\n");
+		dev_dbg(mpp->dev, "No niu hclk reset resource define\n");
 	dec->rst_core = mpp_reset_control_get(mpp, RST_TYPE_CORE, "video_core");
 	if (!dec->rst_core)
 		mpp_err("No core reset resource define\n");
diff --git a/drivers/video/rockchip/mpp/mpp_rkvdec2.c b/drivers/video/rockchip/mpp/mpp_rkvdec2.c
--- a/drivers/video/rockchip/mpp/mpp_rkvdec2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvdec2.c
@@ -1296,12 +1296,17 @@ static int rkvdec2_init(struct mpp_dev *mpp)
 	dec->rst_h = mpp_reset_control_get(mpp, RST_TYPE_H, "video_h");
 	if (!dec->rst_h)
 		mpp_err("No hclk reset resource define\n");
+	/*
+	 * The NIU resets are optional: a decoder node that names none (the RK356x rkvdec,
+	 * whose reset-names are video_a/h, cabac, core and hevc_cabac) is reset without
+	 * them, as mpp_safe_reset()/mpp_safe_unreset() skip a NULL control.
+	 */
 	dec->rst_niu_a = mpp_reset_control_get(mpp, RST_TYPE_NIU_A, "niu_a");
 	if (!dec->rst_niu_a)
-		mpp_err("No niu aclk reset resource define\n");
+		dev_dbg(mpp->dev, "No niu aclk reset resource define\n");
 	dec->rst_niu_h = mpp_reset_control_get(mpp, RST_TYPE_NIU_H, "niu_h");
 	if (!dec->rst_niu_h)
-		mpp_err("No niu hclk reset resource define\n");
+		dev_dbg(mpp->dev, "No niu hclk reset resource define\n");
 	dec->rst_core = mpp_reset_control_get(mpp, RST_TYPE_CORE, "video_core");
 	if (!dec->rst_core)
 		mpp_err("No core reset resource define\n");
