+ * id bytes alone, retrying 5 times 200 ms apart after its reset.
+ */
+#define FT_REGISTER_CHIP_ID_HIGH	0xa3
+#define FT_REGISTER_CHIP_ID_LOW		0x9f
+#define FT_REGISTER_FW_VERSION		0xa6
+#define FT_CHIP_ID_RETRIES		5
+#define FT_CHIP_ID_RETRY_DELAY		200 /* msec */
+
 #define TOUCH_EVENT_DOWN		0x00
 #define TOUCH_EVENT_UP			0x01
 #define TOUCH_EVENT_ON			0x02
@@ -145,12 +156,18 @@ struct edt_ft5x06_ts_data {
 
 	struct edt_reg_addr reg_addr;
