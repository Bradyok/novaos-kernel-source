 	if (!error) {
-		regmap_write(regmap, reg_addr->reg_gain, val);
+		if (reg_addr->reg_gain != NO_REGISTER)
+			regmap_write(regmap, reg_addr->reg_gain, val);
 		tsdata->gain = val;
 	}
 
@@ -1024,8 +1098,10 @@ static void edt_ft5x06_ts_get_parameters(struct edt_ft5x06_ts_data *tsdata)
 	struct regmap *regmap = tsdata->regmap;
 	unsigned int val;
 
-	regmap_read(regmap, reg_addr->reg_threshold, &tsdata->threshold);
-	regmap_read(regmap, reg_addr->reg_gain, &tsdata->gain);
+	if (reg_addr->reg_threshold != NO_REGISTER)
+		regmap_read(regmap, reg_addr->reg_threshold, &tsdata->threshold);
+	if (reg_addr->reg_gain != NO_REGISTER)
+		regmap_read(regmap, reg_addr->reg_gain, &tsdata->gain);
 	if (reg_addr->reg_offset != NO_REGISTER)
 		regmap_read(regmap, reg_addr->reg_offset, &tsdata->offset);
 	if (reg_addr->reg_offset_x != NO_REGISTER)
@@ -1117,6 +1193,16 @@ static void edt_ft5x06_ts_set_regs(struct edt_ft5x06_ts_data *tsdata)
 		reg_addr->reg_offset_y = NO_REGISTER;
 		reg_addr->reg_num_x = NO_REGISTER;
 		reg_addr->reg_num_y = NO_REGISTER;
+		/*
+		 * None of the M09 tuning registers is in FocalTech's own register map
+		 * for its parts (its driver touches 0xa5 power mode, nothing here), so a
+		 * FocalTech-firmware part is never written one, nor restored one on resume.
