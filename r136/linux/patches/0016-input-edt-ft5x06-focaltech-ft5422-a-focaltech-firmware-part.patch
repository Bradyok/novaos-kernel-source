+/*
+ * A FocalTech controller running FocalTech's firmware (not an EDT module) is identified the
+ * way FocalTech's own driver does it: by the chip id in 0xa3/0x9f. The EDT heuristics below
+ * would read 0xbb for an EDT model string and then take 0xa8 -- on these parts the panel
+ * maker's vendor id -- as a model number, and a panel whose vendor id happens to be 0x59 would
+ * be driven as an Evervision FT5726 with x and y swapped. Its touch data is FocalTech's
+ * standard report (TD_STATUS at 0x02, 6-byte points from 0x03), which is what GENERIC_FT reads.
+ */
+static int edt_ft5x06_focaltech_identify(struct i2c_client *client,
+					 struct edt_ft5x06_ts_data *tsdata)
+{
+	unsigned int id_high = 0, id_low = 0, fw_version = 0;
+	int retries = FT_CHIP_ID_RETRIES;
+	int error;
+
+	for (;;) {
+		error = regmap_read(tsdata->regmap, FT_REGISTER_CHIP_ID_HIGH,
+				    &id_high);
+		if (!error)
+			error = regmap_read(tsdata->regmap,
+					    FT_REGISTER_CHIP_ID_LOW, &id_low);
+		if (!error && id_high && id_high != 0xff && id_low)
+			break;
+		if (--retries == 0) {
+			dev_err(&client->dev,
+				"no FocalTech chip id: 0x%02x%02x, error %d\n",
+				id_high, id_low, error);
+			return error ?: -ENODEV;
+		}
+		msleep(FT_CHIP_ID_RETRY_DELAY);
+	}
+
+	error = regmap_read(tsdata->regmap, FT_REGISTER_FW_VERSION,
+			    &fw_version);
+	if (error)
+		return error;
+
+	tsdata->version = GENERIC_FT;
+	snprintf(tsdata->name, EDT_NAME_LEN, "FocalTech FT%02x%02x",
+		 id_high, id_low);
+	snprintf(tsdata->fw_version, EDT_NAME_LEN, "0x%02x", fw_version);
+	dev_info(&client->dev,
+		 "FocalTech chip id 0x%02x%02x, firmware 0x%02x, %d touch points\n",
+		 id_high, id_low, fw_version, tsdata->max_support_points);
+
+	return 0;
+}
+
 static int edt_ft5x06_ts_identify(struct i2c_client *client,
 				  struct edt_ft5x06_ts_data *tsdata)
 {
@@ -862,6 +931,9 @@ static int edt_ft5x06_ts_identify(struct i2c_client *client,
 	char *model_name = tsdata->name;
