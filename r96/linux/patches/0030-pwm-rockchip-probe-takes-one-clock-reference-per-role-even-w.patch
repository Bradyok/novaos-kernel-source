From: Brady <brady@aioscilloscope.com>
Subject: pwm: rockchip: probe takes one clock reference per role, even when both roles are one clock (6.12)
Copyright (C) 2026 Olympian LED, Inc.

On SoCs whose PWM node lists one clock (RK3288, RK3399), the driver uses
that clock as both the PWM clock and the APB clock. Probe enabled it once
(devm_clk_get_enabled) but dropped it twice at its end, so every channel
that was not already running at probe released a reference it never took,
and every channel that was running was left holding none. On RK3399 that
clock (pclk_rkpwm_pmu) is critical, so the clock core refuses the extra
release with a "Disabling critical" warning, at probe or at the first
disable of a PWM later on. Probe now prepares and enables the clock once per
role, as the upstream driver does, and releases both on its error paths;
remove() already unprepares both.

---
diff --git a/drivers/pwm/pwm-rockchip.c b/drivers/pwm/pwm-rockchip.c
--- a/drivers/pwm/pwm-rockchip.c
+++ b/drivers/pwm/pwm-rockchip.c
@@ -2535,9 +2535,9 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 		else if (!strcmp(clk_src_name, "rc"))
 			clk_src_sel = SRC_CLK_PWM_RC;
 	}
-	pc->clk = devm_clk_get_enabled(&pdev->dev, clk_src_name);
+	pc->clk = devm_clk_get(&pdev->dev, clk_src_name);
 	if (IS_ERR(pc->clk)) {
-		pc->clk = devm_clk_get_enabled(&pdev->dev, NULL);
+		pc->clk = devm_clk_get(&pdev->dev, NULL);
 		if (IS_ERR(pc->clk))
 			return dev_err_probe(&pdev->dev, PTR_ERR(pc->clk),
 					     "Can't get %s clk\n", clk_src_name);
@@ -2546,7 +2546,7 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 	count = of_count_phandle_with_args(pdev->dev.of_node,
 					   "clocks", "#clock-cells");
 	if (count >= 2) {
-		pc->pclk = devm_clk_get_enabled(&pdev->dev, "pclk");
+		pc->pclk = devm_clk_get(&pdev->dev, "pclk");
 		pc->clk_osc = devm_clk_get_optional(&pdev->dev, "osc");
 		if (IS_ERR(pc->clk_osc))
 			return dev_err_probe(&pdev->dev, PTR_ERR(pc->clk_osc),
@@ -2558,16 +2558,35 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 	if (IS_ERR(pc->pclk))
 		return dev_err_probe(&pdev->dev, PTR_ERR(pc->pclk), "Can't get APB clk\n");
 
+	/*
+	 * One reference for the PWM clock and one for the APB clock, taken even
+	 * when they are the same clock (a single "clocks" entry, as on RK3288 and
+	 * RK3399): the end of probe drops one of each, and keeps the PWM clock's
+	 * only while the PWM is already running, which rockchip_pwm_enable()
+	 * drops when it is turned off.
+	 */
+	ret = clk_prepare_enable(pc->clk);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "Can't prepare enable PWM clk\n");
+
+	ret = clk_prepare_enable(pc->pclk);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "Can't prepare enable APB clk\n");
+		goto err_clk;
+	}
+
 	pc->pinctrl = devm_pinctrl_get(&pdev->dev);
 	if (IS_ERR(pc->pinctrl)) {
 		dev_err(&pdev->dev, "Get pinctrl failed!\n");
-		return PTR_ERR(pc->pinctrl);
+		ret = PTR_ERR(pc->pinctrl);
+		goto err_pclk;
 	}
 
 	pc->active_state = pinctrl_lookup_state(pc->pinctrl, "active");
 	if (IS_ERR(pc->active_state)) {
 		dev_err(&pdev->dev, "No active pinctrl state\n");
-		return PTR_ERR(pc->active_state);
+		ret = PTR_ERR(pc->active_state);
+		goto err_pclk;
 	}
 
 	pc->data = device_get_match_data(&pdev->dev);
@@ -2597,7 +2616,8 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 	}
 	if (pc->channel_id < 0 || pc->channel_id >= PWM_MAX_CHANNEL_NUM) {
 		dev_err(&pdev->dev, "Channel id is out of range: %d\n", pc->channel_id);
-		return -EINVAL;
+		ret = -EINVAL;
+		goto err_pclk;
 	}
 
 	if (pc->main_version == 4)
@@ -2627,7 +2647,7 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 					       irq_flags, "rk_pwm_irq", chip);
 			if (ret) {
 				dev_err(&pdev->dev, "Claim IRQ failed\n");
-				return ret;
+				goto err_pclk;
 			}
 		}
 	}
@@ -2648,7 +2668,7 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 	ret = devm_pwmchip_add(&pdev->dev, chip);
 	if (ret < 0) {
 		dev_err_probe(&pdev->dev, ret, "pwmchip_add() failed\n");
-		return ret;
+		goto err_pclk;
 	}
 
 	platform_set_drvdata(pdev, chip);
@@ -2656,13 +2676,14 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 	if (pc->wave_support) {
 		if (!pc->clk_osc) {
 			dev_err(&pdev->dev, "Can't find OSC clk for wave generator mode\n");
-			return -EINVAL;
+			ret = -EINVAL;
+			goto err_pclk;
 		}
 
 		ret = clk_prepare(pc->clk_osc);
 		if (ret) {
 			dev_err(&pdev->dev, "Can't prepare OSC clk for wave generator mode\n");
-			return ret;
+			goto err_pclk;
 		}
 	}
 
@@ -2674,8 +2695,10 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 		init_completion(&pc->ir_trans_completion);
 
 		rcdev = devm_rc_allocate_device(&pdev->dev, RC_DRIVER_IR_RAW_TX);
-		if (!rcdev)
-			return -ENOMEM;
+		if (!rcdev) {
+			ret = -ENOMEM;
+			goto err_osc;
+		}
 
 		rcdev->priv = chip;
 		rcdev->driver_name = "rockchip-pwm-ir-tx";
@@ -2683,7 +2706,7 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 		rcdev->tx_ir = rockchip_pwm_ir_transmit;
 		ret = devm_rc_register_device(&pdev->dev, rcdev);
 		if (ret < 0)
-			return ret;
+			goto err_osc;
 	}
 #endif
 
@@ -2696,6 +2719,18 @@ static int rockchip_pwm_probe(struct platform_device *pdev)
 	clk_disable(pc->pclk);
 
 	return 0;
+
+#ifdef CONFIG_RC_CORE
+err_osc:
+	if (pc->wave_support)
+		clk_unprepare(pc->clk_osc);
+#endif
+err_pclk:
+	clk_disable_unprepare(pc->pclk);
+err_clk:
+	clk_disable_unprepare(pc->clk);
+
+	return ret;
 }
 
 static void rockchip_pwm_remove(struct platform_device *pdev)
